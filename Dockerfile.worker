# Multi-stage Dockerfile for the ThinClaw worker container.
#
# This image runs the thinclaw binary in worker mode inside Docker containers.
# The orchestrator creates instances of this image for sandboxed job execution.
#
# Build:
#   docker build -f Dockerfile.worker -t thinclaw-worker .
#
# The image includes common development tools so workers can build software,
# run tests, and execute shell commands.

FROM node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e AS worker-tools

WORKDIR /opt/worker-tools
COPY release/worker-tools/package.json release/worker-tools/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && case "$(dpkg --print-architecture)" in \
        amd64) worker_arch=x64 ;; \
        arm64) worker_arch=arm64 ;; \
        *) echo "unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && install -m 0755 \
        "node_modules/@anthropic-ai/claude-code-linux-${worker_arch}/claude" \
        node_modules/@anthropic-ai/claude-code/bin/claude.exe \
    && npm cache clean --force

# ---

FROM rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f AS builder

WORKDIR /build
COPY . .

# Build the worker binary with Docker sandbox support enabled so the
# container entrypoints expose the internal bridge subcommands.
RUN cargo build --release --features docker-sandbox --bin thinclaw

# ---

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

# The Debian snapshot fixes the complete apt package universe. Its metadata is
# verified by the archive keyring already present in the digest-pinned base.
# Bootstrap TLS trust from the digest-pinned Node stage before contacting it.
COPY --from=worker-tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        'Types: deb' \
        'URIs: https://snapshot.debian.org/archive/debian/20260803T000000Z' \
        'Suites: bookworm' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        'URIs: https://snapshot.debian.org/archive/debian-security/20260803T000000Z' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    gh \
    && rm -rf /var/lib/apt/lists/*

# Copy the exact Rust and Node toolchains and the npm-lock-verified coding CLIs
# from digest-pinned build stages. No remote bootstrap script runs in the image.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    CODEX_HOME=/home/sandbox/.codex \
    PATH=/opt/worker-tools/node_modules/.bin:/usr/local/cargo/bin:$PATH
COPY --from=builder /usr/local/rustup /usr/local/rustup
COPY --from=builder /usr/local/cargo /usr/local/cargo
COPY --from=worker-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=worker-tools /opt/worker-tools /opt/worker-tools
RUN chmod -R a+rX /usr/local/rustup /usr/local/cargo /opt/worker-tools

# Copy the binary
COPY --from=builder /build/target/release/thinclaw /usr/local/bin/thinclaw

# Create non-root user (UID 1000 matches the orchestrator's container config)
RUN useradd -m -u 1000 -s /bin/bash sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace \
    && mkdir -p /home/sandbox/.claude \
    && mkdir -p /home/sandbox/.codex \
    && chown sandbox:sandbox /home/sandbox/.claude /home/sandbox/.codex

USER sandbox
WORKDIR /workspace

# A separate, credential-free process validates the heartbeat emitted by the
# worker's Tokio event loop. Stopped or wedged workers therefore become stale.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD ["thinclaw", "worker-health", "--max-age", "20", "--heartbeat-file", "/tmp/thinclaw-worker-heartbeat.json"]

# The orchestrator passes the worker/bridge/relay subcommand as Docker cmd.
ENTRYPOINT ["thinclaw"]
